{
    "choose_browser": "patchright",
    "email_suffix": "@outlook.com",
    "recovery_mailbox": {
        "auto_fetch": true,
        "accounts_file": "Results/backup_email.txt",
        "token_dir": "Results/recovery_mailbox_token",
        "legacy_token_cache": "Results/recovery_mailbox_token.json",
        "timeout_seconds": 180,
        "poll_interval_seconds": 3,
        "message_lookback_seconds": 30,
        "code_pattern": "(?<!\\d)(\\d{6,8})(?!\\d)"
    },
    "proxy": "",
    "fingerprint": {
        "enabled": true,
        "headless": false,
        "locale": "en-US",
        "languages": [
            "en-US",
            "en"
        ],
        "timezone_id": "America/Los_Angeles",
        "geolocation": {
            "longitude": -118.2437,
            "latitude": 34.0522,
            "accuracy": 25
        },
        "color_scheme": "light",
        "hardware_concurrency": [
            4,
            8,
            12,
            16
        ],
        "device_memory": [
            4,
            8
        ],
        "device_scale_factor": [
            1,
            1.25
        ]
    },
    "bot_protection_wait": 50,
    "max_captcha_retries": 8,
    "concurrent_flows": 2,
    "max_tasks": 2,
   "oauth2": {
    "enable_oauth2": false,
    "Loop Creation": false,
    "client_id": "",
    "redirect_url": "",
    "Scopes": [
        "offline_access",
        "https://graph.microsoft.com/Mail.ReadWrite",
        "https://graph.microsoft.com/Mail.Send",
        "https://graph.microsoft.com/User.Read"
    ]
    },
    "playwright": {
        "browser_path": ""
    },
    "info": "外层参数必须填写,内部参数可选.email_suffix参数只能是@outlook.com或者@hotmail.com.playwright可用性较差.并且使用playwright指纹浏览器要能过https://www.browserscan.net,否则请使用patchright.请本地搭建代理池."
}
